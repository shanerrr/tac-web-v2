---
import Photo from '../components/Photo.astro';
import Ridge from '../components/Ridge.astro';
import { grain } from '../grain';
import Layout from '../layouts/Layout.astro';
import { getStories } from '../lib/contentful';

// The ring hills: circles whose centres sit below the frame, in the 1440 x 900 space of the approved sketch.
// Listed back to front. Each is opaque and covers the ones before it, so ring lines never cross.
const hills = [
	{ cx: 250, cy: 1010, r: 430, ink: 'var(--rust)' },
	{ cx: 1230, cy: 990, r: 450, ink: 'var(--must)' },
	{ cx: 730, cy: 1150, r: 620, ink: 'var(--tang)' },
	{ cx: 1080, cy: 1230, r: 520, ink: 'var(--olive)' },
	{ cx: 300, cy: 1260, r: 480, ink: 'var(--must)' },
];
const rings = (r: number, step = 26) =>
	Array.from({ length: Math.floor((r - 20) / step) }, (_, i) => r - step * (i + 1));
// Each walker stands on a hill's ridge: [hill index, degrees from the top, scale].
const walkers = [
	[0, -1.5, 1], [0, 1.6, 0.85],
	[2, -8.5, 1], [2, -3, 0.85], [2, -0.8, 1],
	[1, -6.5, 1], [1, -3.2, 0.9], [1, 7.5, 1],
	[3, -17, 1], [3, -14, 0.85],
	[4, 14, 1],
];
// Left to look at the hero, each hill's group talks: left to right they take turns leaning in to their neighbour.
// Someone alone on a hill looks around instead.
const chat = walkers.map((w) => {
	const group = walkers.filter(([hi]) => hi === w[0]).sort((a, b) => a[1] - b[1]);
	const turn = group.indexOf(w);
	return { turn, alone: group.length === 1, lean: turn === 0 ? 8 : -8 };
});

// The newest two written stories and the newest film in the feed.
const stories = (await getStories()).filter((s) => s.inFeed);
const written = stories.filter((s) => s.format === 'written').slice(0, 2);

// The two quotes stay close in length: past 160 characters a quote keeps the person's opening sentences, whole, and
// marks the rest as left out; the full words are in their story. Their own quote marks are dropped; the page sets its own.
const sentences = new Intl.Segmenter('en-CA', { granularity: 'sentence' });
const excerpt = (quote: string) => {
	const words = quote.trim().replace(/^["“]|["”]$/g, '');
	if (words.length <= 160) return words;
	let out = '';
	for (const { segment } of sentences.segment(words)) {
		if (out && (out + segment).trim().length > 160) break;
		out += segment;
	}
	return `${out.trim()} …`;
};
const faces = written.map((data) => ({
	...data,
	line: data.quote && excerpt(data.quote),
	meta: [data.location, data.pronouns].filter(Boolean),
}));

const film = stories.find((s) => s.format === 'film');
// The film plays here from YouTube's privacy-enhanced player once asked for; without script its link opens YouTube.
const filmId = film?.youtubeUrl && (() => {
	const url = new URL(film.youtubeUrl);
	return url.hostname.endsWith('youtu.be') ? url.pathname.slice(1) : url.searchParams.get('v');
})();
---

<Layout>
	<section class="hero">
		<div class="hero-copy">
			<h1><span style="--i:0">We’re all aging.</span> <span style="--i:1">Let’s talk about it.</span></h1>
		</div>
		<div class="hills" aria-hidden="true">
			<svg viewBox="0 470 1440 430" preserveAspectRatio="xMidYMin slice">
				<defs>
					<pattern id="hero-grain" patternUnits="userSpaceOnUse" width="240" height="240">
						<image href={grain} width="240" height="240" />
					</pattern>
				</defs>
				{
					hills.map((h, i) => (
						<g class="hill" style={`--i:${i}; transform-origin:${h.cx}px ${h.cy}px`}>
							<circle cx={h.cx} cy={h.cy} r={h.r} fill={h.ink} />
							{rings(h.r).map((r) => (
								<circle cx={h.cx} cy={h.cy} r={r} fill="none" stroke="var(--paper)" stroke-width="5" opacity=".75" />
							))}
							{/* The grain prints inside each hill, so the people on the ridges stay solid ink. */}
							<circle cx={h.cx} cy={h.cy} r={h.r} fill="url(#hero-grain)" />
						</g>
					))
				}
				{
					walkers.map(([hi, deg, s], i) => {
						const h = hills[hi];
						return (
							<g class:list={['stroll', { front: hi > 2 }]} style={`transform-origin:${h.cx}px ${h.cy}px`}>
								<g class="walker" style={`--i:${i}; --from:${deg < 0 ? -14 : 14}deg; transform-origin:${h.cx}px ${h.cy}px`}>
									<g transform={`rotate(${deg} ${h.cx} ${h.cy}) translate(${h.cx} ${h.cy - h.r}) scale(${s * 1.25})`} fill="var(--ink)">
										<g class="step">
											<g class="hop">
												<g
													class:list={['chat', { alone: chat[i].alone }]}
													style={`--hill:${hi}; --turn:${chat[i].turn}; --lean:${chat[i].lean}deg`}
												>
													<circle class="head" cy="-34" r="6" />
													<rect x="-6" y="-26" width="12" height="27" rx="6" />
												</g>
											</g>
										</g>
									</g>
								</g>
							</g>
						);
					})
				}
			</svg>
		</div>
		<a class="btn btn-paper hero-cta" href="#ageism" aria-label="Learn more: how we’re redefining what it means to grow older">
			Learn more
			<svg viewBox="0 0 16 24" aria-hidden="true"><path d="M8 2v19M2 15l6 6 6-6" /></svg>
		</a>
		<button class="btn btn-paper motion-toggle chat-toggle" type="button" hidden>
			<svg viewBox="0 0 16 16" aria-hidden="true"><path class="i-pause" d="M5 3v10M11 3v10" /><path class="i-play" d="M5 3l8 5-8 5z" /></svg>
			<span class="sr-only">Pause the people talking</span>
		</button>
	</section>

	<!-- From here the page is one walk: each section rises as the crown of the next hill. -->
	<section class="ageism" id="ageism" aria-labelledby="ageism-h">
		<Ridge h={120} hills={[{ ink: 'var(--ink)', s: 104 }]} grain={0.45} />
		<div class="wrap">
			<h2 id="ageism-h">We’re redefining what it means <span>to grow older.</span></h2>
			<div class="ageism-grid">
				<div class="argument">
					<p>
						How we think about aging shapes how we grow older, how we treat one another, and the kind of
						communities we build together.
					</p>
					<p>
						Through storytelling, art, education, and community engagement, The Age Collective challenges
						ageism, amplifies diverse voices, and brings generations together to reimagine aging.
					</p>
					<a class="btn btn-paper" href="/about">Why we do this work</a>
				</div>
				<div class="voices">
					<figure>
						<blockquote>
							<p>
								“Racism, sexism, etc. – none of this is okay, but ageism is somehow still acceptable in a
								lot of different sectors.”
							</p>
						</blockquote>
						<figcaption>Jamie, 24</figcaption>
					</figure>
					<figure>
						<blockquote>
							<p>
								“Some seniors are being abused, even by their own families. Some are new immigrant
								seniors who don’t understand the system.”
							</p>
						</blockquote>
						<figcaption>Sushila, 72</figcaption>
					</figure>
				</div>
			</div>
		</div>
	</section>

	<section class="stories" id="stories" aria-labelledby="stories-h">
		<Ridge
			hills={[
				{ ink: 'var(--rust)', s: 150, cx: 230, r: 300, rings: true },
				{ ink: 'var(--paper)', s: 92, cx: 860 },
			]}
		/>
		<div class="stories-head wrap">
			<h2 id="stories-h">Every story adds a new perspective.</h2>
			<a class="btn" href="/stories">
				See all stories and films
				<svg viewBox="0 0 24 16" aria-hidden="true"><path d="M2 8h19M15 2l6 6-6 6" /></svg>
			</a>
		</div>
		<ul class="spreads wrap">
			{
				faces.map((f) => (
					<li class="spread">
						<figure>
						<div class="photo arch">
							<Photo
								photo={f.image}
								width={520}
								height={650}
								sizes="(min-width: 48rem) 26rem, calc(100vw - 2.5rem)"
							/>
						</div>
							{f.line && (
								<blockquote>
									<span class="mark" aria-hidden="true">“</span>
									<p>
										<span class="sr-only">“</span>
										{f.line}”
									</p>
								</blockquote>
							)}
							<figcaption class="tag">
								<span class="name">
									{f.name}, {f.age}
								</span>
								{f.meta.length > 0 && (
									<span class="meta">
										{f.meta.map((item, j) => (
											<>
												{j > 0 && ' '}
												<span>
													{j > 0 && '· '}
													{item}
												</span>
											</>
										))}
									</span>
								)}
							</figcaption>
						</figure>
					</li>
				))
			}
		</ul>
		{
			film && filmId && (
				<div class="film wrap">
					<div class="photo frame" data-film={filmId}>
						<Photo
							photo={film.image}
							width={1280}
							height={720}
							sizes="(min-width: 76rem) 50rem, (min-width: 64rem) 66vw, calc(100vw - 2.5rem)"
						/>
						<a class="play" href={film.youtubeUrl} aria-label={`Play the film: ${film.headline ?? `${film.name}, ${film.age}`}`}>
							<span class="btn">
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path d="M5 3l8 5-8 5z" />
								</svg>
								Play the film
							</span>
						</a>
					</div>
					<div class="label">
						<p class="kind">Film{film.durationMinutes && ` · ${film.durationMinutes} min`}</p>
						<h3 class="name">{film.headline ?? `${film.name}, ${film.age}`}</h3>
						{film.quote && <p class="line">“{excerpt(film.quote)}”</p>}
						<p class="meta">
							{[
								film.headline && `${film.name}, ${film.age}`,
								film.location,
								film.pronouns,
							]
								.filter(Boolean)
								.map((item, j) => (
									<>
										{j > 0 && ' '}
										<span>
											{j > 0 && '· '}
											{item}
										</span>
									</>
								))}
						</p>
					</div>
				</div>
			)
		}
	</section>

	<section class="projects wrap" aria-labelledby="projects-h">
		<h2 id="projects-h">What we’ve created together.</h2>
		<div class="project-pair">
			<article class="project sheet" style="--sheet:var(--must)">
				<h3>Growing Older, Living Deeply (GOLD) Poetry Project</h3>
				<p class="lead">
					40 poems by 40 older adults from across Canada, brought together in a digital anthology exploring
					the many layers of growing older.
				</p>
				<a href="/projects/gold">See the GOLD Poetry Project</a>
			</article>
			<article class="project sheet" style="--sheet:var(--must)">
				<h3>My Aging Story Exhibit</h3>
				<p class="lead">An in-person exhibit featuring 22 personal stories from individuals across the lifespan.</p>
				<a href="/projects/my-aging-story">See the exhibit</a>
			</article>
		</div>
	</section>

	<section class="talk sheet" aria-labelledby="talk-h">
		<Ridge hills={[{ ink: 'var(--sage)', s: 78, cx: 520 }]} grain={0.45} />
		<svg class="talk-hill" viewBox="0 0 600 300" aria-hidden="true">
			<g class="hill">
				<circle cx="300" cy="420" r="380" fill="var(--rust)"></circle>
				{rings(380).map((r) => <circle cx="300" cy="420" r={r} fill="none" stroke="var(--paper)" stroke-width="5" opacity=".75" />)}
			</g>
			{
				[-3.4, 3.4].map((deg, i) => (
					<g transform={`rotate(${deg} 300 420) translate(300 40) scale(${(i ? 0.85 : 1) * 1.5})`}>
						<g class="jump" style={`--i:${i}`}>
							<g fill="var(--ink)">
								<circle cy="-34" r="6" />
								<rect x="-6" y="-26" width="12" height="27" rx="6" />
							</g>
							<g class="shout" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linecap="round">
								<path d="M-7.7 -40.4L-13.8 -45.6M0 -44V-53M7.7 -40.4L13.8 -45.6" />
							</g>
						</g>
					</g>
				))
			}
		</svg>
		<div class="wrap">
			<h2 id="talk-h">Be part of the conversation.</h2>
			<p>Have a story, question, or idea to share? We’d love to hear from you!</p>
			<p class="mail">
				<a class="btn" href="mailto:info@theagecollective.com">Email us</a>
				<span>info@theagecollective.com</span>
			</p>
		</div>
		<button class="btn btn-paper motion-toggle shout-toggle" type="button" hidden>
			<svg viewBox="0 0 16 16" aria-hidden="true"><path class="i-pause" d="M5 3v10M11 3v10" /><path class="i-play" d="M5 3l8 5-8 5z" /></svg>
			<span class="sr-only">Pause the people shouting</span>
		</button>
	</section>
</Layout>

<script>
	// Left to look at the hero for a few seconds, the people on the hills talk. A scroll, key, tap or click freezes them
	// where they are (no snapping back), and they carry on after the next quiet spell. The button stops them for good.
	const hero = document.querySelector<HTMLElement>('.hero')!;
	const chatToggle = hero.querySelector<HTMLButtonElement>('.chat-toggle')!;
	if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
		chatToggle.hidden = false;
		let inView = false;
		let quiet = 0;
		const stir = () => {
			hero.removeAttribute('data-chatting');
			clearTimeout(quiet);
			if (inView) quiet = setTimeout(() => hero.setAttribute('data-chatting', ''), 4000);
		};
		new IntersectionObserver(
			([e]) => {
				inView = e.isIntersecting;
				stir();
			},
			{ threshold: 0.5 },
		).observe(hero);
		for (const type of ['scroll', 'wheel', 'keydown', 'touchstart', 'pointerdown']) addEventListener(type, stir, { passive: true });
		chatToggle.addEventListener('click', () => {
			const paused = hero.toggleAttribute('data-paused');
			chatToggle.querySelector('.sr-only')!.textContent = `${paused ? 'Play' : 'Pause'} the people talking`;
		});
	}

	// The people on the closing hill shout only while their sheet is on screen, and stop for good once paused.
	const talk = document.querySelector<HTMLElement>('.talk')!;
	new IntersectionObserver(([e]) => talk.toggleAttribute('data-shouting', e.isIntersecting)).observe(talk);
	const toggle = talk.querySelector<HTMLButtonElement>('.shout-toggle')!;
	toggle.hidden = false;
	toggle.addEventListener('click', () => {
		const paused = talk.toggleAttribute('data-paused');
		toggle.querySelector('.sr-only')!.textContent = `${paused ? 'Play' : 'Pause'} the people shouting`;
	});

	// Pressing play swaps the still for the player, captions on, and hands it focus so the keyboard carries on there.
	const frame = document.querySelector<HTMLElement>('[data-film]');
	frame?.querySelector('.play')!.addEventListener('click', (e) => {
		e.preventDefault();
		const player = document.createElement('iframe');
		player.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.film}?autoplay=1&cc_load_policy=1&rel=0`;
		player.title = frame.closest('.film')!.querySelector('h3')!.textContent!;
		player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
		player.allowFullscreen = true;
		frame.replaceChildren(player);
		frame.dataset.playing = '';
		player.focus();
	});
</script>

<style>
	/*
	 * The long walk. Sections after the hero rise as hill crowns (see Ridge), each drawn in proportion to its width:
	 * --crown is a full-width ridge's height, so the section above leaves room for it.
	 */
	section {
		--crown: max(2.5rem, 100vw * 160 / 1440);
		position: relative;
		padding-block: var(--space);
	}

	section h2 + p,
	section h3 + p {
		margin-top: 1.25rem;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/*
	 * Hero: the tagline owns the sky, the ring hills hold the ground.
	 * The copy keeps its own height: generous air under the header, then an interval before the scene.
	 * The hills take whatever height is left of the first screen, so the spacing holds on any screen shape.
	 * The one action sits on the hills at the bottom centre of the first screen, out of the sky.
	 * Below the fold the hills run on for --handoff, and the Ink sheet's crown rises over them there: the hand-off
	 * from hills to the next sheet happens as the visitor scrolls, never in the first screen.
	 */
	.hero {
		/* The Ink crown's height (a 1440 x 120 ridge, at least 2.5rem), plus a strip of hills before it. */
		--handoff: calc(max(2.5rem, 100vw * 120 / 1440) + clamp(1.5rem, 4vw, 3.5rem));
		display: flex;
		flex-direction: column;
		min-height: calc(100svh - var(--header) + var(--handoff));
		padding-block: 0 var(--handoff);
		background: var(--grain), var(--paper);
	}

	/* Above the drawing, which runs up into the sky for the tallest figures. */
	.hero-copy {
		position: relative;
		z-index: 1;
		padding: clamp(1.5rem, 11vh, 7.5rem) var(--gutter) clamp(1.5rem, 8vh, 5rem);
		text-align: center;
	}

	/*
	 * The tagline's size is capped by height so it clears the hills on a short screen, and the cap rises again past
	 * about 2000px wide so it keeps its place beside the hills on a very large one.
	 */
	h1 {
		font-size: clamp(2.25rem, min(6vw, 10vh), max(4.75rem, 3.75vw));
	}

	h1 span {
		display: block;
		color: var(--ink);
	}

	/* The first line is said plainly; the second carries the weight. */
	h1 span:first-child {
		font-weight: 400;
	}

	.hero-cta {
		position: absolute;
		inset: auto 0 calc(var(--handoff) + clamp(1.25rem, 4vh, 2.5rem));
		z-index: 1;
		gap: 0.625rem;
		width: fit-content;
		margin-inline: auto;
		outline: 4px solid;
	}

	.hero-cta svg {
		height: 1.1em;
		fill: none;
		stroke: currentColor;
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: translate 0.25s var(--ease);
	}

	.hero-cta:is(:hover, :focus-visible) svg {
		translate: 0 0.2rem;
	}

	/* A phone on its side: the button drops to the header's target size, and the people on the two front hills step out of its way. */
	@media (height < 28rem) {
		.hero-cta {
			min-height: 3rem;
			padding-block: 0;
			font-size: 1.125rem;
		}

		.front {
			display: none;
		}
	}

	/*
	 * The drawing is pinned to its top edge and scaled to cover the first screen's share: a short box crops the foot of
	 * the hills, a tall one enlarges them, and the ridges and figures are never cut. Past its box the drawing runs on:
	 * up into the sky for the tallest figures, and down through the hand-off below the fold. The sides stay cropped.
	 */
	.hills {
		position: relative;
		flex: 1 0 min(15rem, 36svh);
		clip-path: inset(-6rem 0 calc(-1 * var(--handoff)) 0);
		/* The clip only hides; this keeps the cropped sides from widening the page. Up and down stay open. */
		overflow-x: clip;
	}

	.hills svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	/* Narrow screens frame x 590 to 1230 of the drawing and let it run on below the viewBox. */
	@media (max-width: 30rem) {
		.hills {
			flex: 1 0 min(97vw, 44svh);
		}

		.hills svg {
			inset: 0 auto auto -92.2vw;
			width: 225vw;
			max-width: none;
			height: auto;
			overflow: visible;
		}
	}

	/*
	 * The print run, once, about four seconds: each tagline line prints into register; the hills grow from their
	 * centres like rings being added; the button prints onto them; the people walk in along the ridges.
	 * Everything rests in its final state by default, so nothing is hidden if the animation never runs.
	 */
	@media (prefers-reduced-motion: no-preference) {
		h1 span {
			animation: land 0.8s var(--ease) backwards;
			animation-delay: calc(var(--i) * 0.25s + 0.1s);
		}

		.hero-cta,
		.hero > .motion-toggle {
			animation: land 0.7s var(--ease) 1.5s backwards;
		}

		/*
		 * Left to look, the people talk: every 4.8s each group passes the word left to right, one leaning in with two
		 * nods while the others wait, each hill a beat after the last. Someone alone looks around. It runs only while the
		 * visitor is still (the script sets data-chatting) and freezes in place otherwise, so nobody snaps upright.
		 */
		.chat,
		.head {
			animation: 4.8s ease-in-out calc(var(--hill) * 0.7s + var(--turn) * 1.5s) infinite both paused;
		}

		.chat {
			animation-name: chat;
			transform-origin: 0 0;
		}

		.chat.alone {
			animation-name: look;
		}

		.head {
			animation-name: nod;
		}

		.alone .head {
			animation: none;
		}

		.hero[data-chatting]:not([data-paused]) :is(.chat, .head) {
			animation-play-state: running;
		}

		.hill {
			animation: grow 1.2s var(--ease) backwards;
			animation-delay: calc(var(--i) * 0.14s + 0.4s);
		}

		.walker {
			animation: walk-in 1.6s var(--ease) backwards;
			animation-delay: calc(var(--i) * 0.06s + 1.7s);
		}

		.step {
			animation: step 0.4s ease-in-out 4 alternate;
			animation-delay: calc(var(--i) * 0.06s + 1.7s);
		}

		/* Reaching for the button, the people hop in a wave. */
		.hero:has(.hero-cta:is(:hover, :focus-visible)) .hop {
			animation: hop 0.5s var(--ease);
			animation-delay: calc(var(--i) * 0.04s);
		}

		/*
		 * Scrolling on, the people walk on with you, from the first pixel of scroll to one screen down. Tied to the page
		 * scroll rather than the hero leaving, which starts only after the hand-off below the fold has passed and would
		 * move them while they are already under the header. Only where scroll timelines exist; otherwise they stand.
		 */
		@supports (animation-timeline: scroll()) {
			/*
			 * Longhands on purpose: given the `animation` shorthand, the production CSS minifier folds the timeline into
