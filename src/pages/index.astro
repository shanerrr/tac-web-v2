---
import { getEmDashCollection } from 'emdash';
import { Image } from 'emdash/ui';
import Layout from '../layouts/Layout.astro';

// The ring hills: circles whose centres sit below the frame, in the 1440 x 900 space of the approved sketch.
// Listed back to front. Each is opaque and covers the ones before it, so ring lines never cross.
const hills = [
	{ cx: 250, cy: 1010, r: 430, ink: 'var(--rust)' },
	{ cx: 1230, cy: 990, r: 450, ink: 'var(--must)' },
	{ cx: 730, cy: 1150, r: 620, ink: 'var(--tang)' },
	{ cx: 1080, cy: 1230, r: 520, ink: 'var(--olive)' },
	{ cx: 300, cy: 1260, r: 480, ink: 'var(--must)' },
];
const rings = (r: number, step = 26) =>
	Array.from({ length: Math.floor((r - 20) / step) }, (_, i) => r - step * (i + 1));
// Each walker stands on a hill's ridge: [hill index, degrees from the top, scale].
const walkers = [
	[0, -1.5, 1], [0, 1.6, 0.85],
	[2, -8.5, 1], [2, -3, 0.85], [2, -0.8, 1],
	[1, -6.5, 1], [1, -3.2, 0.9], [1, 7.5, 1],
	[3, -17, 1], [3, -14, 0.85],
	[4, 14, 1],
];

const newest = (format: 'written' | 'film', limit: number) =>
	getEmDashCollection('stories', { where: { format, in_feed: true }, orderBy: { published_at: 'desc' }, limit });
const results = await Promise.all([
	// The newest two written stories and the newest film in the feed.
	newest('written', 2),
	newest('film', 1),
]);
// A failed query must not be cached for a day as a home page without stories.
if (results.some((r) => r.error)) Astro.cache?.set(false);
else if (Astro.cache?.enabled) for (const r of results) Astro.cache.set(r.cacheHint);

// The two labels stay close in length: past 160 characters a label keeps the person's opening sentences, whole, and
// marks the rest as left out; the full words are in their story. Their own quote marks are dropped; the label sets its own.
const sentences = new Intl.Segmenter('en-CA', { granularity: 'sentence' });
const excerpt = (quote: string) => {
	const words = quote.trim().replace(/^["“]|["”]$/g, '');
	if (words.length <= 160) return words;
	let out = '';
	for (const { segment } of sentences.segment(words)) {
		if (out && (out + segment).trim().length > 160) break;
		out += segment;
	}
	return `${out.trim()} …`;
};
const faces = results[0].entries.map(({ data }, i) => ({ ...data, ink: ['rust', 'sage'][i], line: data.quote && excerpt(data.quote) }));

const film = results[1].entries[0]?.data;
// The film plays here from YouTube's privacy-enhanced player once asked for; without script its link opens YouTube.
const filmId = film?.youtube_url && (() => {
	const url = new URL(film.youtube_url);
	return url.hostname.endsWith('youtu.be') ? url.pathname.slice(1) : url.searchParams.get('v');
})();
---

<Layout>
	<section class="hero">
		<div class="hero-copy">
			<h1><span style="--i:0">We’re all aging.</span> <span style="--i:1">Let’s talk about it.</span></h1>
		</div>
		<div class="hills" aria-hidden="true">
			<svg viewBox="0 470 1440 430" preserveAspectRatio="xMidYMin slice">
				{
					hills.map((h, i) => (
						<g class="hill" style={`--i:${i}; transform-origin:${h.cx}px ${h.cy}px`}>
							<circle cx={h.cx} cy={h.cy} r={h.r} fill={h.ink} />
							{rings(h.r).map((r) => (
								<circle cx={h.cx} cy={h.cy} r={r} fill="none" stroke="var(--paper)" stroke-width="5" opacity=".75" />
							))}
						</g>
					))
				}
				{
					walkers.map(([hi, deg, s], i) => {
						const h = hills[hi];
						return (
							<g class:list={['stroll', { front: hi > 2 }]} style={`transform-origin:${h.cx}px ${h.cy}px`}>
								<g class="walker" style={`--i:${i}; --from:${deg < 0 ? -14 : 14}deg; transform-origin:${h.cx}px ${h.cy}px`}>
									<g transform={`rotate(${deg} ${h.cx} ${h.cy}) translate(${h.cx} ${h.cy - h.r}) scale(${s * 1.25})`} fill="var(--ink)">
										<g class="step">
											<g class="hop">
												<circle cy="-34" r="6" />
												<rect x="-6" y="-26" width="12" height="27" rx="6" />
											</g>
										</g>
									</g>
								</g>
							</g>
						);
					})
				}
			</svg>
		</div>
		<a class="btn btn-paper hero-cta" href="#ageism" aria-label="Learn more: why ageism is the problem">
			Learn more
			<svg viewBox="0 0 16 24" aria-hidden="true"><path d="M8 2v19M2 15l6 6 6-6" /></svg>
		</a>
	</section>

	<section class="ageism" id="ageism" aria-labelledby="ageism-h">
		<div class="wrap ageism-grid">
			<div>
				<h2 id="ageism-h">Aging isn’t the problem. <span>Ageism is.</span></h2>
				<p>
					Ageism is the way we think, feel, or act towards people based on age. It is one of the most
					common and normalized forms of discrimination, and it shows up in everyday language, in
					media, and in how systems like healthcare, housing, and employment are designed.
				</p>
				<a class="btn btn-paper" href="/about">Why we do this work</a>
			</div>
			<div class="voices">
				<figure>
					<blockquote>
						<p>
							“Racism, sexism, etc. – none of this is okay, but ageism is somehow still acceptable in a
							lot of different sectors.”
						</p>
					</blockquote>
					<figcaption>Jamie, 24</figcaption>
				</figure>
				<figure>
					<blockquote>
						<p>
							“Some seniors are being abused, even by their own families. Some are new immigrant
							seniors who don’t understand the system.”
						</p>
					</blockquote>
					<figcaption>Sushila, 72</figcaption>
				</figure>
			</div>
		</div>
	</section>

	<section class="stories" id="stories" aria-labelledby="stories-h">
		<div class="stories-head wrap">
			<h2 id="stories-h">In their own words.</h2>
			<a class="btn" href="/stories">
				See all stories and films
				<svg viewBox="0 0 24 16" aria-hidden="true"><path d="M2 8h19M15 2l6 6-6 6" /></svg>
			</a>
		</div>
		<ul class="row wrap">
			{
				faces.map((f) => (
					<li class:list={['face', f.ink]}>
						<div class="photo">
							<Image
								image={f.image}
								width={480}
								height={600}
								sizes="(min-width: 87rem) 19rem, (min-width: 64rem) 22vw, (min-width: 48rem) 45vw, calc(100vw - 2.5rem)"
								placeholder={false}
							/>
						</div>
						<div class="label">
							<p class="name">
								{f.name}, {f.age}
							</p>
							{f.line && <p class="line">“{f.line}”</p>}
						</div>
					</li>
				))
			}
			{
				film && filmId && (
					<li class="film">
						<div class="photo frame" data-film={filmId}>
							<Image
								image={film.image}
								width={960}
								height={540}
								sizes="(min-width: 76rem) 36rem, (min-width: 64rem) 40vw, calc(100vw - 2.5rem)"
								placeholder={false}
							/>
							<a class="play" href={film.youtube_url} aria-label={`Play the film: ${film.headline ?? `${film.name}, ${film.age}`}`}>
								<span class="btn">
									<svg viewBox="0 0 16 16" aria-hidden="true">
										<path d="M5 3l8 5-8 5z" />
									</svg>
									Play the film
								</span>
							</a>
						</div>
						<div class="label">
							<h3 class="name">{film.headline ?? `${film.name}, ${film.age}`}</h3>
							{film.quote && <p class="line">“{excerpt(film.quote)}”</p>}
							<p class="meta">
							{[
								film.headline && `${film.name}, ${film.age}`,
								film.location,
								film.pronouns,
								Number.isFinite(film.duration_minutes) && `${film.duration_minutes} min`,
							]
								.filter(Boolean)
								.map((item, j) => (
									<>
										{j > 0 && ' '}
										<span>
											{j > 0 && '· '}
											{item}
										</span>
									</>
								))}
							</p>
						</div>
					</li>
				)
			}
		</ul>
	</section>

	<section class="projects wrap" aria-labelledby="projects-h">
		<h2 id="projects-h">What we’ve made together.</h2>
		<div class="project-pair">
			<article class="project sheet" style="--sheet:var(--must)">
				<h3>GOLD: Growing Older, Living Deeply</h3>
				<p class="figure">319 poems</p>
				<p>
					Submitted by adults 55 and older across four national calls, June 2025 to February 2026. A
					panel of older adult poets chose forty for a digital anthology.
				</p>
				<a href="/projects/gold">See the GOLD Poetry Project</a>
			</article>
			<article class="project sheet" style="--sheet:var(--sage)">
				<h3>My Aging Story</h3>
				<p class="figure">22 stories</p>
				<p>Collected over three years and shown in person in Edmonton on February 21–&#8288;22, 2025.</p>
				<a href="/projects/my-aging-story">See the exhibit</a>
			</article>
		</div>
	</section>

	<section class="talk sheet" aria-labelledby="talk-h">
		<svg class="talk-hill" viewBox="0 0 600 300" aria-hidden="true">
			<g class="hill">
				<circle cx="300" cy="420" r="380" fill="var(--rust)"></circle>
				{rings(380).map((r) => <circle cx="300" cy="420" r={r} fill="none" stroke="var(--paper)" stroke-width="5" opacity=".75" />)}
			</g>
			{
				[-3.4, 3.4].map((deg, i) => (
					<g transform={`rotate(${deg} 300 420) translate(300 40) scale(${i ? 0.85 : 1})`} fill="var(--ink)">
						<circle cy="-34" r="6" />
						<rect x="-6" y="-26" width="12" height="27" rx="6" />
					</g>
				))
			}
		</svg>
		<div class="wrap">
			<h2 id="talk-h">Let’s talk about it.</h2>
			<p>Tell us your story, ask a question, or bring us into your community.</p>
			<a class="btn" href="mailto:info@theagecollective.com">info@theagecollective.com</a>
		</div>
	</section>
</Layout>

<script>
	// Pressing play swaps the still for the player, captions on, and hands it focus so the keyboard carries on there.
	const frame = document.querySelector<HTMLElement>('[data-film]');
	frame?.querySelector('.play')!.addEventListener('click', (e) => {
		e.preventDefault();
		const player = document.createElement('iframe');
		player.src = `https://www.youtube-nocookie.com/embed/${frame.dataset.film}?autoplay=1&cc_load_policy=1&rel=0`;
		player.title = frame.closest('.film')!.querySelector('h3')!.textContent!;
		player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
		player.allowFullscreen = true;
		frame.replaceChildren(player);
		frame.dataset.playing = '';
		player.focus();
	});
</script>

<style>
	section {
		padding-block: var(--space);
	}

	/* Two paper sections in a row share one interval, not two. */
	.stories + .projects {
		padding-top: 0;
	}

	section h2 + p,
	section h3 + p {
		margin-top: 1.25rem;
	}

	/*
	 * Hero: the tagline owns the sky, the ring hills hold the ground.
	 * The copy keeps its own height: generous air under the header, then an interval before the scene.
	 * The hills take whatever height is left, so the spacing holds on any screen shape.
	 * The one action sits on the hills at the bottom centre, out of the sky.
	 */
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: calc(100svh - var(--header));
		padding-block: 0;
		background: var(--paper);
	}

	/* Above the grain that covers the scene. */
	.hero-copy {
		position: relative;
		z-index: 1;
		padding: clamp(1.5rem, 11vh, 7.5rem) var(--gutter) clamp(1.5rem, 8vh, 5rem);
		text-align: center;
	}

	/*
	 * The tagline's size is capped by height so it clears the hills on a short screen, and the cap rises again past
	 * about 2000px wide so it keeps its place beside the hills on a very large one.
	 */
	h1 {
		font-size: clamp(2.25rem, min(6vw, 10vh), max(4.75rem, 3.75vw));
	}

	h1 span {
		display: block;
		color: var(--ink);
	}

	/* The first line is said plainly; the second carries the weight. */
	h1 span:first-child {
		font-weight: 400;
	}

	.hero-cta {
		position: absolute;
		inset: auto 0 clamp(1.25rem, 4vh, 2.5rem);
		z-index: 1;
		gap: 0.625rem;
		width: fit-content;
		margin-inline: auto;
		outline: 4px solid;
	}

	.hero-cta svg {
		height: 1.1em;
		fill: none;
		stroke: currentColor;
		stroke-width: 3;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: translate 0.25s var(--ease);
	}

	.hero-cta:is(:hover, :focus-visible) svg {
		translate: 0 0.2rem;
	}

	/* A phone on its side: the button drops to the header's target size, and the people on the two front hills step out of its way. */
	@media (height < 28rem) {
		.hero-cta {
			min-height: 3rem;
			padding-block: 0;
			font-size: 1.125rem;
		}

		.front {
			display: none;
		}
	}

	/* Grain over sky and hills alike, under the words. */
	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: var(--grain);
		pointer-events: none;
	}

	/*
	 * The drawing is pinned to its top edge and scaled to cover: a short box crops the foot of the hills, a tall one
	 * enlarges them. On a very short screen (a phone on its side) the hills give up height so the button stays in view.
	 */
	.hills {
		position: relative;
		flex: 1 0 min(15rem, 36svh);
	}

	.hills svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}

	/* Narrow screens frame x 590 to 1230 of the drawing and let it run on below the viewBox. */
	@media (max-width: 30rem) {
		/* Capped by height so the button on the hills stays inside the first screen on a short phone. */
		.hills {
			flex: 1 0 min(97vw, 44svh);
			overflow: hidden;
		}

		.hills svg {
			inset: 0 auto auto -92.2vw;
			width: 225vw;
			max-width: none;
			height: auto;
			overflow: visible;
		}
	}

	/*
	 * One authored moment, once, about four seconds: the sheet prints in passes.
	 * Each tagline line prints into register; the hills grow from their centres like rings being added; the
	 * button prints onto them; the people walk in along the ridges.
	 * Everything rests in its final state by default, so nothing is hidden if the animation never runs.
	 * Fills are backwards only: once a pass has landed the animation lets go, so hover transitions still run.
	 */
	@media (prefers-reduced-motion: no-preference) {
		h1 span {
			animation: land 0.8s var(--ease) backwards;
			animation-delay: calc(var(--i) * 0.25s + 0.1s);
		}

		.hero-cta {
			animation: land 0.7s var(--ease) 1.5s backwards;
		}

		.hill {
			animation: grow 1.2s var(--ease) backwards;
			animation-delay: calc(var(--i) * 0.14s + 0.4s);
		}

		.walker {
			animation: walk-in 1.6s var(--ease) backwards;
			animation-delay: calc(var(--i) * 0.06s + 1.7s);
		}

		.step {
			animation: step 0.4s ease-in-out 4 alternate;
			animation-delay: calc(var(--i) * 0.06s + 1.7s);
		}

		/* Reaching for the button, the people hop in a wave. */
		.hero:has(.hero-cta:is(:hover, :focus-visible)) .hop {
			animation: hop 0.5s var(--ease);
			animation-delay: calc(var(--i) * 0.04s);
		}

		/* Scrolling on, the people walk on with you. Only where scroll timelines exist; otherwise they stand. */
		@supports (animation-timeline: view()) {
			.hero {
				view-timeline: --hero block;
			}

			.stroll {
				animation: stroll linear both;
				animation-timeline: --hero;
				animation-range: exit 0% exit 100%;
			}
		}
	}

	@keyframes land {
		from {
			opacity: 0;
			translate: -0.05em -0.04em;
		}
	}

	@keyframes grow {
		from {
			opacity: 0;
			scale: 0.72;
		}
	}

	@keyframes walk-in {
		from {
			opacity: 0;
			rotate: var(--from);
		}
	}

	@keyframes step {
		to {
			translate: 0 -3px;
		}
	}

	@keyframes hop {
		40% {
			translate: 0 -9px;
		}
	}

	@keyframes stroll {
		to {
			rotate: 9deg;
		}
	}

	/*
	 * Stories: two portraits at a fixed size, each with its person's name and words on a band of ink that starts over
	 * the photo's foot and hangs below it, so the words never cover a face. The newest film fills the rest of the row,
	 * on a band of its own, and the way to all stories is a button beside the headline. Below 64rem the film drops under the portraits;
	 * below 48rem all stacks.
	 */
	.stories {
		--face: clamp(15rem, 22vw, 19rem);
		--gap: clamp(1rem, 2vw, 1.5rem);
	}

	/* The way to all stories is the section's one button, beside the headline (under it on a phone). */
	.stories-head {
		display: grid;
		gap: 2rem;
		justify-items: start;
	}

	/* Its arrow is drawn like the hero button's, turned to point on, and steps on when the button is used. */
	.stories-head .btn {
		gap: 0.625rem;
	}

	.stories-head svg {
		width: 1.25em;
		fill: none;
		stroke: currentColor;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
		transition: translate 0.25s var(--ease);
	}

	.stories-head .btn:is(:hover, :focus-visible) svg {
		translate: 0.25rem 0;
	}

	.row {
		display: grid;
		gap: var(--gap);
		margin-top: clamp(2.5rem, 5vw, 4rem);
	}

	/*
	 * A real photograph is printed as it is: full colour, no frame, no grain over the face.
	 * Its ground (--slot) shows until the photo arrives.
	 */
	.photo {
		position: relative;
		/* Clipped, so a photo delivered at another shape is cropped to the frame rather than growing it. */
		overflow: hidden;
		aspect-ratio: 4 / 5;
		background: var(--slot);
	}

	.photo :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	/*
	 * A plate: a picture over its label. Portraits and the film are printed alike; side by side they stretch to one
	 * height, so their bands end level.
	 */
	.face,
	.film {
		--name: clamp(1.0625rem, 8cqi, 1.5rem);
		display: flex;
		flex-direction: column;
		container-type: inline-size;
	}

	/* Each portrait is given one ink by its place: rust, then sage. Rust is the dark ink, so its words are paper. */
	.face.rust {
		--slot: var(--rust);
		--on-slot: var(--paper);
	}

	.face.sage {
		--slot: var(--sage);
	}

	/*
	 * The label: a flat band of the portrait's ink. Its name line prints over the photo's foot, where the name always
	 * sat; the person's words continue below the photo. Type steps with the portrait's width, never under 1.0625rem.
	 */
	.row .label {
		position: relative;
		flex: 1;
		display: grid;
		align-content: start;
		gap: 0.375rem;
		margin-top: calc(-0.75rem - 1.15 * var(--name) - 0.375rem);
		padding: 0.75rem 0.875rem 1rem;
		background: var(--slot);
		color: var(--on-slot, var(--ink));
	}

	.row .name {
		font: 800 var(--name) / 1.15 var(--font-display);
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	/* Their words in curly quotes, the opening mark hung so the words keep the label's edge. */
	.row .line {
		font: 500 clamp(1.0625rem, 6cqi, 1.1875rem) / 1.35 var(--font-display);
		text-indent: -0.4em;
		text-wrap: pretty;
	}

	/* Paper on rust blooms, so the rust label's words take the ageism sheet's extra tracking. */
	.face.rust .line {
		letter-spacing: 0.01em;
	}

	/* The film's plate is the third ink, tangerine: its still's ground until it loads, then the band under it. */
	.film {
		--slot: var(--tang);
	}

	.film .frame {
		aspect-ratio: 16 / 9;
	}

	/* On a phone a 16:9 still under its band is a sliver with the play button over the faces; it stands at 4:3 until played. */
	@media (width < 48rem) {
		.film .frame:not([data-playing]) {
			aspect-ratio: 4 / 3;
		}
	}

	/* Playing, the frame is grounded in the player's own ink and the band steps off its foot, where the controls are. */
	.film .frame[data-playing] {
		background: var(--ink);
	}

	.film .frame[data-playing] + .label {
		margin-top: 0;
	}

	/* Global: the player is added by script, so it never carries this page's scoping attribute. */
	.frame :global(iframe) {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	/* The whole still is the play target; the Ink pill on it un-prints when any of it is used. */
	.play {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		text-decoration: none;
	}

	.play .btn {
		gap: 0.625rem;
	}

	.play:is(:hover, :focus-visible, :active) .btn {
		background-color: var(--paper);
		color: var(--ink);
	}

	.play svg {
		width: 0.875em;
		height: 0.875em;
		fill: currentColor;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linejoin: round;
	}

	.film .meta {
		margin-top: 0.125rem;
	}

	/* Labels (metadata lines, captions) sit a step under the reading text. Each metadata item keeps together. */
	.meta,
	.voices figcaption {
		font-size: 1.125rem;
		font-weight: 700;
	}

	.meta span {
		white-space: nowrap;
	}

	@media (min-width: 48rem) {
		.row {
